{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis canonical selected-scope run receipt v1",
  "type": "object",
  "required": ["schema", "run_id", "started_at_utc", "ended_at_utc", "profile", "source", "status", "exit_code", "cases", "counts", "cleanup", "resources", "artifacts", "suite_inputs", "protected_effects"],
  "properties": {
    "schema": {"const": "jarvis-canonical-test-run/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "profile": {"enum": ["core", "entry", "protocol", "resources", "all", "acceptance"]},
    "source": {
      "type": "object", "required": ["path"],
      "properties": {
        "path": {"type": "string"}, "version": {"type": "string"},
        "loaded_version": {"type": "string"}, "code_sha256": {"$ref": "#/$defs/hash"},
        "loaded_identity_verified": {"type": "boolean"}
      }
    },
    "status": {"enum": ["listed", "passed_selected_scope", "failed", "incomplete", "deadline", "interrupted", "source_rejected", "runner_error", "worker_error"]},
    "exit_code": {"enum": [0, 1, 2, 3, 124, 130]},
    "cases": {"type": "array", "items": {
      "type": "object", "required": ["selector", "case_id", "origin", "blocks", "evidence_level", "status", "started", "events", "basis"],
      "properties": {
        "selector": {"type": "string"}, "case_id": {"type": "string"},
        "origin": {"enum": ["source", "legacy", "suite", "fixture", "gap"]},
        "blocks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^B0[1-8]$"}},
        "status": {"enum": ["passed", "failed", "error", "skipped", "partial", "not_run", "not_implemented"]},
        "started": {"type": "boolean"}, "basis": {"type": "string"},
        "evidence_level": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/hash"},
        "events": {"type": "array", "items": {
          "type": "object", "required": ["kind"],
          "properties": {
            "kind": {"enum": ["failure", "error", "skip", "subtest_failure", "subtest_error", "subtest_skip", "subtest_pass"]},
            "subtest_id": {"type": "string"}, "detail": {"type": "string"}, "reason": {"type": "string"}
          }
        }}
      }
    }},
    "counts": {"$ref": "#/$defs/counts"},
    "block_counts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/counts"}},
    "cleanup": {"type": "object", "required": ["confirmed"], "properties": {"confirmed": {"type": "boolean"}}},
    "resources": {"type": "object", "required": ["samples", "acceptance"], "properties": {
      "samples": {"type": "array"}, "acceptance": {"const": "measurement_only_no_threshold"}
    }},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {
      "path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}
    }}},
    "suite_inputs": {"type": "array", "minItems": 5},
    "protected_effects": {"type": "object", "required": ["model_turns", "external_messages", "production_accessed", "target_modified", "runtime_config_modified", "service_restart"]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "passed_selected_scope"}}}, "then": {
    "properties": {
      "exit_code": {"const": 0},
      "source": {"required": ["loaded_identity_verified"], "properties": {"loaded_identity_verified": {"const": true}}},
      "cleanup": {"properties": {"confirmed": {"const": true}}},
      "counts": {"properties": {"methods_run": {"minimum": 1}, "failed": {"const": 0}, "error": {"const": 0}, "skipped": {"const": 0}, "partial": {"const": 0}, "not_run": {"const": 0}, "not_implemented": {"const": 0}}}
    }
  }}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"type": "object", "required": ["methods_run", "passed", "failed", "error", "skipped", "partial", "not_run", "not_implemented", "failure_records", "error_records", "method_skip_records", "subtest_skip_records"], "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
