+    def _remember_thread_cwd(
+        self, response: dict[str, Any], thread_id: str, *, require_current: bool = False,
+    ) -> None:
+        """Retain only the exact thread's native working directory, never its history."""
+        self._thread_cwds.pop(thread_id, None)
+        thread = response.get("thread")
+        if not isinstance(thread, dict) or thread.get("id") != thread_id:
+            raise _SelectionError("invalid thread selection context: thread.id",
+                                  stage="thread_context", field="thread.id")
+        if require_current and "cwd" not in response:
+            raise _SelectionError("thread selection context is missing current cwd",
+                                  stage="thread_context", field="cwd")
+        # Start/resume expose the current context at the top level. Thread.cwd
+        # is the captured directory and is also available from metadata reads.
+        cwd = response["cwd"] if "cwd" in response else thread.get("cwd")
+        if cwd is None and "cwd" not in response and "cwd" not in thread:
+            return
+        if not isinstance(cwd, str) or not cwd or not Path(cwd).is_absolute():
+            raise _SelectionError("invalid thread selection context: cwd",
+                                  stage="thread_context", field="cwd")
+        self._thread_cwds[thread_id] = cwd
+        if len(self._thread_cwds) > _THREAD_CWD_CACHE_LIMIT:
+            self._thread_cwds.popitem(last=False)
+
+    def _selection_cwd(self, thread_id: str) -> str:
+        if thread_id not in self._thread_cwds:
+            # thread/read exposes captured cwd, which may differ from the live
+            # context after a resume. Reattach this exact thread without history
+            # or overrides and require the current native directory instead.
+            response = self.request("thread/resume", {"threadId": thread_id, "excludeTurns": True})
+            self._remember_thread_cwd(response, thread_id, require_current=True)
+        cwd = self._thread_cwds.get(thread_id)
+        if cwd is None:
+            raise _SelectionError("thread selection context is missing cwd",
+                                  stage="thread_context", field="cwd")
+        self._thread_cwds.move_to_end(thread_id)
+        return cwd
+
+    def _effective_selection(self, cwd: str | None = None) -> tuple[dict[str, str | None], dict[str, str]]:
+        """Project one real response immediately; do not retain unrelated values."""
+        params: dict[str, Any] = {"includeLayers": False}
+        if cwd is not None:
+            params["cwd"] = cwd
+        response = self.request("config/read", params)
+        config, origins = response.get("config"), response.get("origins")
+        if not isinstance(config, dict) or not isinstance(origins, dict):
+            raise _SelectionError("invalid config/read selection response", stage="config/read", error_code="invalid_response")
+        fields = ("model", "model_reasoning_effort", "service_tier")
+        selected = {key: _selection_value(config.get(key), key) for key in fields}
+        sources = {}
+        for key in fields:
+            origin = origins.get(key)
+            name = origin.get("name") if isinstance(origin, dict) else None
+            kind = name.get("type") if isinstance(name, dict) else None
+            sources[key] = "config/read:" + (kind if kind in {"sessionFlags", "user", "system", "project", "managed"} else "effective")
+        for key, expected in getattr(self.config, "instance_selection", {}).items():
+            if selected[key] != expected:
+                raise _SelectionError("instance selection not confirmed by config/read: " + key,
+                                      stage="instance_verification", field=key, error_code="mismatch")
+        return selected, sources
+
+    def _resolve_selection(
+        self, requested_model: str | None = None, requested_effort: str | None = None,
+        *, requested_tier: str | None = None, cwd: str | None = None,
+        thread_id: str | None = None,
+    ) -> _NativeSelection:
+        self.start()
+        if requested_model and requested_effort is not None and requested_tier is not None:
+            return _NativeSelection(requested_model, requested_effort, requested_tier,
+                                    effort_source="request", tier_source="request")
+        if thread_id is not None:
+            cwd = self._selection_cwd(thread_id)
+        effective, sources = self._effective_selection(cwd)
+        model = requested_model or effective["model"]
+        model_source = "request" if requested_model else sources["model"]
+        catalog_default = None
+        catalog_status = "not_read"
+        ids = []
+        if not requested_model:
+            catalog_status = "read"
+            try:
+                models = self.available_models()
+                ids = [str(item.get("id") or item.get("model") or "").strip() for item in models]
+                catalog_default = next((model_id for model_id, item in zip(ids, models)
+                                        if model_id and item.get("isDefault") is True), None)
+            except NativeTaskError:
+                if model is None:
+                    raise
+                # Diagnosis may be unavailable; a configured ID is never substituted.
+                catalog_status = "unavailable"
+        if model is None:
+            model = catalog_default or next((value for value in ids if value), None)
+            if model is None:
+                raise _SelectionError("app-server model/list returned no supported models",
+                                      stage="catalog_fallback", error_code="empty_catalog")
+            model_source = "model/list:default" if catalog_default else "model/list:first"
+        effort = requested_effort if requested_effort is not None else effective["model_reasoning_effort"]
+        tier = requested_tier if requested_tier is not None else effective["service_tier"]
+        return _NativeSelection(
+            model, effort, tier, model_source,
+            "request" if requested_effort is not None else sources["model_reasoning_effort"] if effort is not None else "native_inherited",
+            "request" if requested_tier is not None else sources["service_tier"] if tier is not None else "native_inherited",
+            catalog_status, catalog_default, cwd,
+        )
 
